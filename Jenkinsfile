pipeline{
  agent any
  stages{
    stage ('build'){
      steps{
        sh 'echo "Build is successful"'
      }
    }
    stage ('Test'){
      steps{
        sh 'echo "Tested positive"'
      }
    }
    stage ('Deploy'){
      steps{
        sh 'echo "Deployed successfully"'
      }
    }
  }
}
